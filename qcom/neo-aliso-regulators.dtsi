	/delete-node/ rpmh-regulator-lcxlvl;
	rpmh-regulator-lcxlvl {
		status = "disabled";
		pm8150_l9_level: regulator-pm8150-l9-level { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa10;
	rpmh-regulator-ldoa10 {
		status = "disabled";
		pm8150_l10: regulator-pm8150-l10 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-lmxlvl;
	rpmh-regulator-lmxlvl {
		status = "disabled";
		pm8150_l11_level: regulator-pm8150-l11-level { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa12;
	rpmh-regulator-ldoa12 {
		status = "disabled";
		pm8150_l12: regulator-pm8150-l12 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa14;
	rpmh-regulator-ldoa14 {
		status = "disabled";
		pm8150_l14: regulator-pm8150-l14 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa15;
	rpmh-regulator-ldoa15 {
		status = "disabled";
		pm8150_l15: regulator-pm8150-l15 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa17;
	rpmh-regulator-ldoa17 {
		status = "disabled";
		pm8150_l17: regulator-pm8150-l17 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa18;
	rpmh-regulator-ldoa18 {
		status = "disabled";
		pm8150_l18: regulator-pm8150-l18 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-cxlvl;
	rpmh-regulator-cxlvl {
		status = "disabled";
		pm8150_s1_level: regulator-pm8150-s1-level { status = "disabled"; };


		pm8150_s1_level_ao: regulator-pm8150-s1-level-ao { status = "disabled"; };


		regulator-pm8150-s1-mmcx-sup-level { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-nsplvl;
	rpmh-regulator-nsplvl {
		status = "disabled";
		pm8150_s3_level: regulator-pm8150-s3-level { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-smpa4;
