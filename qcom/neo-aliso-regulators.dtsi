#include <dt-bindings/regulator/qcom,rpmh-regulator-levels.h>

&apps_rsc_drv2 {

	/delete-node/ rpmh-regulator-ldoa1;
	rpmh-regulator-ldoa1 {
		status = "disabled";
		pm8150_l1: regulator-pm8150-l1 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa2;
	rpmh-regulator-ldoa2 {
		status = "disabled";
		pm8150_l2: regulator-pm8150-l2 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa3;
	rpmh-regulator-ldoa3 {
		status = "disabled";
		pm8150_l3: regulator-pm8150-l3 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa5;
	rpmh-regulator-ldoa5 {
		status = "disabled";
		pm8150_l5: regulator-pm8150-l5 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa6;
	rpmh-regulator-ldoa6 {
		status = "disabled";
		pm8150_l6: regulator-pm8150-l6 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-ldoa7;
	rpmh-regulator-ldoa7 {
