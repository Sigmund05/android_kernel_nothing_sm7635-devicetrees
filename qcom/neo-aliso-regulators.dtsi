		pm8150_s8_level_ao: regulator-pm8150-s8-level-ao { status = "disabled"; };


		regulator-pm8150-s8-mmcx-voter-level { status = "disabled"; };


		regulator-pm8150-s8-gfx-voter-level { status = "disabled"; };
