		status = "disabled";
		pm8150_s5: regulator-pm8150-s5 { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-mxlvl;
	rpmh-regulator-mxlvl {
		status = "disabled";
		pm8150_s6_level: regulator-pm8150-s6-level { status = "disabled"; };


		pm8150_s6_level_ao: regulator-pm8150-s6-level-ao { status = "disabled"; };
	};

	/delete-node/ rpmh-regulator-mmcxlvl;
	rpmh-regulator-mmcxlvl {
		status = "disabled";
